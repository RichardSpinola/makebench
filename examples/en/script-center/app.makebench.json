    {
      "id": "flow_e1473cbd6f6e",
      "name": "Click: Test script argument",
      "event": {
        "kind": "click",
        "component": "button_install"
      },
      "body": [
        {
          "id": "block_009",
          "op": "ask",
          "kind": "text",
          "name": "argument",
          "prompt": {
            "id": "block_007",
            "op": "literal",
            "value": "What text should the script receive?"
          },
          "options": {
            "id": "block_008",
            "op": "list",
            "items": []
          }
        },
        {
          "id": "block_013",
          "op": "script",
          "source": {
            "id": "block_010",
            "op": "literal",
            "value": "set -eu\nprintf \"Argument received literally: %s\\n\" \"$1\"\nprintf \"End of script.\\n\""
          },
          "arguments": {
            "id": "block_012",
            "op": "list",
            "items": [
              {
                "id": "block_011",
                "op": "variable",
                "name": "argument"
              }
            ]
          },
          "admin": false
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_9a677193d807",
      "name": "Click: Ask and simulate installation",
      "event": {
        "kind": "click",
        "component": "button_setup"
      },
      "body": [
        {
          "id": "block_018",
          "op": "ask",
          "kind": "choice",
          "name": "package",
          "prompt": {
            "id": "block_014",
            "op": "literal",
            "value": "Which application do you want to simulate?"
          },
          "options": {
            "id": "block_017",
            "op": "list",
            "items": [
              {
                "id": "block_015",
                "op": "literal",
                "value": "Text editor"
              },
              {
                "id": "block_016",
                "op": "literal",
                "value": "Music player"
              }
            ]
          }
        },
        {
          "id": "block_020",
          "op": "confirm",
          "prompt": {
            "id": "block_019",
            "op": "literal",
            "value": "Start the simulation? No package will be installed."
          }
        },
        {
          "id": "block_022",
          "op": "call_function",
          "function": "fn_simulate_installation",
          "args": [
            {
              "id": "block_021",
              "op": "variable",
              "name": "package"
            }
          ]
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_a699be6306e3",
