#!/usr/bin/env python3
"""Executa o checkout local; usa a .venv do projeto quando disponível."""

import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parent
virtual_python = root / ".venv" / "bin" / "python"
if virtual_python.is_file() and Path(sys.prefix).resolve() != (root / ".venv").resolve():
    os.execv(str(virtual_python), [str(virtual_python), str(Path(__file__).resolve()), *sys.argv[1:]])
sys.path.insert(0, str(root / "src"))

from makebench.__main__ import main

raise SystemExit(main())
