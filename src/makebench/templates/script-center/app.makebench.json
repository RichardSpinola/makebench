      },
      "body": [
        {
          "id": "block_032",
          "op": "ask",
          "kind": "file",
          "name": "file_path",
          "prompt": {
            "id": "block_030",
            "op": "literal",
            "value": "Choose a file to show its path"
          },
          "options": {
            "id": "block_031",
            "op": "list",
            "items": []
          }
        },
        {
          "id": "block_034",
          "op": "log",
          "value": {
            "id": "block_033",
            "op": "variable",
            "name": "file_path"
          }
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_af41bd46f83c",
      "name": "Click: Check administrative authorization",
      "event": {
        "kind": "click",
        "component": "button_admin"
      },
      "body": [
        {
          "id": "block_038",
          "op": "run",
          "program": {
            "id": "block_035",
            "op": "literal",
            "value": "/usr/bin/id"
          },
          "arguments": {
            "id": "block_037",
            "op": "list",
            "items": [
              {
                "id": "block_036",
                "op": "literal",
                "value": "-u"
              }
            ]
          },
          "admin": true
        },
        {
          "id": "block_040",
          "op": "log",
          "value": {
            "id": "block_039",
            "op": "literal",
            "value": "The administrative task finished."
          }
        }
      ],
      "workspace": {}
