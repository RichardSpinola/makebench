  "workflows": [
    {
      "id": "flow_3ff99f40f025",
      "name": "On start",
      "event": {
        "kind": "start",
        "component": "window_main"
      },
      "body": [
        {
          "id": "block_002",
          "op": "log",
          "value": {
            "id": "block_001",
            "op": "literal",
            "value": "Task center ready. Choose a task."
          }
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_4ded1dcedb2d",
      "name": "Click: System information",
      "event": {
        "kind": "click",
        "component": "button_check"
      },
      "body": [
        {
          "id": "block_006",
          "op": "run",
          "program": {
            "id": "block_003",
            "op": "literal",
            "value": "uname"
          },
          "arguments": {
            "id": "block_005",
            "op": "list",
            "items": [
              {
                "id": "block_004",
                "op": "literal",
                "value": "-a"
              }
            ]
          },
          "admin": false
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_e1473cbd6f6e",
      "name": "Click: Test script argument",
      "event": {
        "kind": "click",
        "component": "button_install"
      },
      "body": [
        {
          "id": "block_009",
          "op": "ask",
          "kind": "text",
          "name": "argument",
          "prompt": {
            "id": "block_007",
            "op": "literal",
            "value": "What text should the script receive?"
          },
          "options": {
            "id": "block_008",
            "op": "list",
            "items": []
          }
        },
        {
          "id": "block_013",
          "op": "script",
          "source": {
            "id": "block_010",
            "op": "literal",
            "value": "set -eu\nprintf \"Argument received literally: %s\\n\" \"$1\"\nprintf \"End of script.\\n\""
          },
          "arguments": {
            "id": "block_012",
            "op": "list",
            "items": [
              {
                "id": "block_011",
                "op": "variable",
                "name": "argument"
              }
            ]
          },
          "admin": false
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_9a677193d807",
      "name": "Click: Ask and simulate installation",
      "event": {
        "kind": "click",
        "component": "button_setup"
      },
      "body": [
        {
          "id": "block_018",
          "op": "ask",
          "kind": "choice",
          "name": "package",
          "prompt": {
            "id": "block_014",
            "op": "literal",
            "value": "Which application do you want to simulate?"
          },
          "options": {
            "id": "block_017",
            "op": "list",
            "items": [
              {
                "id": "block_015",
                "op": "literal",
                "value": "Text editor"
              },
              {
                "id": "block_016",
                "op": "literal",
                "value": "Music player"
              }
            ]
          }
        },
        {
          "id": "block_020",
          "op": "confirm",
          "prompt": {
            "id": "block_019",
            "op": "literal",
            "value": "Start the simulation? No package will be installed."
          }
        },
        {
          "id": "block_022",
          "op": "call",
          "function": "simulate_installation",
          "value": {
            "id": "block_021",
            "op": "variable",
            "name": "package"
          }
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_a699be6306e3",
      "name": "Click: Error example",
      "event": {
        "kind": "click",
        "component": "button_error"
      },
      "body": [
        {
          "id": "block_025",
          "op": "script",
          "source": {
            "id": "block_023",
            "op": "literal",
            "value": "printf \"Starting error example\\n\"\nprintf \"Simulated failure: code 7\\n\" >&2\nexit 7"
          },
          "arguments": {
            "id": "block_024",
            "op": "list",
            "items": []
          },
          "admin": false
        },
        {
          "id": "block_027",
          "op": "log",
          "value": {
            "id": "block_026",
            "op": "literal",
            "value": "This message must not appear after the failure."
          }
        }
      ],
      "workspace": {}
    },
    {
      "id": "flow_518fb5c3eae3",
      "name": "Click: Long task to cancel",
      "event": {
        "kind": "click",
        "component": "button_long"
      },
      "body": [
        {
          "id": "block_029",
          "op": "call",
          "function": "long_task",
          "value": {
            "id": "block_028",
